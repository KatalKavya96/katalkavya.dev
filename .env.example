# Optional server token for GitHub profile, repository, and PR reads.
GITHUB_TOKEN=

# Create a GitHub OAuth App using the callback URL
# http://localhost:3000/api/auth/github/callback for local development.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Fine-grained token scoped to KatalKavya96/katalkavya.dev.
# Repository permissions: Contents (read/write), Metadata (read).
GITHUB_CONTENT_TOKEN=
